// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// Um destino/região visitada nas expedições (ex: Península Antártica, Geórgia do Sul)
model Destination {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  summary     String
  description String
  heroImage   String?
  highlights  String // JSON-encoded string[] com destaques do destino
  order       Int      @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  expeditions ExpeditionDestination[]

  @@index([published, order])
}

// Uma embarcação usada nas expedições
model Vessel {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  summary     String
  description String
  capacity    Int?
  heroImage   String?
  gallery     String? // JSON-encoded string[] de URLs de imagens
  amenities   String? // JSON-encoded string[]
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  expeditions Expedition[]

  @@index([published])
}

// Um pacote/itinerário de expedição
model Expedition {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  summary     String
  description String
  durationDays Int
  season      String // ex: "Outubro a Março"
  startingFrom String? // ex: "Ushuaia, Argentina"
  priceFrom   Float?
  priceCurrency String @default("USD")
  heroImage   String?
  itinerary   String? // JSON-encoded { day, title, description }[]
  included    String? // JSON-encoded string[]
  excluded    String? // JSON-encoded string[]
  published   Boolean  @default(true)
  featured    Boolean  @default(false)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  vesselId    String?
  vessel      Vessel? @relation(fields: [vesselId], references: [id])

  destinations ExpeditionDestination[]
  inquiries    Inquiry[]

  @@index([published, order])
}

// Tabela de junção N:N entre Expedition e Destination
model ExpeditionDestination {
  expeditionId String
  expedition   Expedition  @relation(fields: [expeditionId], references: [id], onDelete: Cascade)
  destinationId String
  destination  Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@id([expeditionId, destinationId])
}

// Pergunta frequente (FAQ), agrupada por categoria
model FaqItem {
  id        String   @id @default(cuid())
  category  String
  question  String
  answer    String
  order     Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([published, category, order])
}

// Solicitação de informações enviada pelo formulário de contato (encaminhada por email)
model Inquiry {
  id           String   @id @default(cuid())
  name         String
  email        String
  phone        String?
  message      String
  expeditionId String?
  expedition   Expedition? @relation(fields: [expeditionId], references: [id])
  emailStatus  String   @default("pending") // pending | sent | failed
  createdAt    DateTime @default(now())

  @@index([createdAt])
}
