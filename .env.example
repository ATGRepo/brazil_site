# Email de destino das solicitações de contato (recebe os leads do formulário)
CONTACT_EMAIL="contato@destinospolares.com.br"

# Configuração de SMTP usada para enviar as solicitações do formulário de contato
SMTP_HOST="smtp.exemplo.com"
SMTP_PORT="587"
SMTP_USER="usuario@exemplo.com"
SMTP_PASSWORD="senha-ou-app-password"
# Remetente exibido no email (opcional, usa SMTP_USER se não definido)
SMTP_FROM="Destinos Polares <contato@destinospolares.com.br>"
